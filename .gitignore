# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Streamlit secrets (never commit API keys)
.streamlit/secrets.toml

# Local environment variables (never commit API keys)
.env

# Certificates / credentials
*.pem
*.key
*.crt

# Defensive: never commit a cached OAuth token, even though the app no
# longer writes this file itself (removed in the multi-user Google sign-in
# change - a shared on-disk token cache was a correctness bug, not just a
# secrets risk).
.google_drive_token.json

# Local session/state
PROGRESS.md

# Streamlit / IDE
.streamlit/*.toml.bak
.idea/
.vscode/

# Local tooling (not part of the deployed app)
.kilo/
.claude/
.devcontainer/
certs/

# Client/source workbooks — contains raw Astranova portfolio data; do not publish
docs/

# Per-user saved profiles / share snapshots (local dummy-login fallback store) —
# contains real client loan tapes
data/profiles/
data/shares/

# Client portfolio data files (workbooks, exports, raw dumps) — never publish
*.xlsx
*.xls
*.csv
scripts/*.txt
scripts/*.xml

# Scratch scripts/dumps used during development — mixes throwaway tooling
# with raw client workbook dumps (sheet contents, real file paths); never
# publish
scripts/archive/
