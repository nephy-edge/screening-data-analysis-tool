# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Streamlit secrets (never commit API keys)
.streamlit/secrets.toml

# Local environment variables (never commit API keys)
.env

# Google Drive OAuth refresh token (local persistence; never commit)
.google_drive_token.json

# Certificates / credentials
*.pem
*.key
*.crt

# Local session/state
PROGRESS.md

# Streamlit / IDE
.streamlit/*.toml.bak
.idea/
.vscode/

# Local tooling (not part of the deployed app)
.kilo/
.claude/
.devcontainer/
certs/

# Client/source workbooks — contains raw Astranova portfolio data; do not publish
docs/

# Client portfolio data files (workbooks, exports, raw dumps) — never publish
*.xlsx
*.xls
*.csv
scripts/*.txt
scripts/*.xml

# Scratch scripts/dumps used during development — mixes throwaway tooling
# with raw client workbook dumps (sheet contents, real file paths); never
# publish
scripts/archive/
